{
    "workbench.colorCustomizations": {
        "editorCursor.foreground": "#ffcc00",
        "terminalCursor.foreground": "#00ffb3"
    },
    "C_Cpp.errorSquiggles": "disabled",
    "C_Cpp.intelliSenseEngine": "default",
    "files.watcherExclude": {
        "**/.git/objects/**": true,
        "**/.git/subtree-cache/**": true,
        "**/node_modules/**": true,
        "**/build/**": true
    },
    "search.exclude": {
        "libraries/": true,
        "build/": true
    }    
}