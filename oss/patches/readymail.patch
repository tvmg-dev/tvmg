+#elif defined(READYMAIL_OPTIMISED) && defined(ENABLE_SMTP)
+
+extern uint8_t scratchBuffer[];
+
+static void rd_src_check(src_data_ctx &src)
+{
+    uint8_t *buf = scratchBuffer;
+    if (!buf) return;
+
+    uint32_t window = 0;
+    size_t total = src.size();
+    size_t readCount = 0;
+
+    while (readCount < total && src.available())
+    {
+        int toRead = (total - readCount > MAX_LINE_LEN) ? MAX_LINE_LEN : (total - readCount);
+        int len = src.read(buf, toRead);
+        if (len <= 0) break;
+
+        for (int i = 0; i < len; i++)
+        {
+            // 1. Bitwise Non-ASCII check
+            if (buf[i] & 0x80) src.nonascii = true;
+
+            // 2. Sliding window for "cid:" (0x6369643A)
+            window = (window << 8) | buf[i];
+            if (window == 0x6369643A) src.cid = true;
+
+            // 3. Check for early exit condition
+            if (src.cid && src.nonascii) break;
+        }
+
+        readCount += len;
+
+        // Break the outer while loop if flags are found
+        if (src.cid && src.nonascii) break;
+    }
+
+    src.close();
+}
+
+#endif
