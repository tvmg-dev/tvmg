+//----------------------------------------------------------------------
+
+// Implement a caching mechanism.  this is using a single buffer for all
+// src_data_ctx instances so is not thread safe !  We are not using malloc
+// to avoid heap fragmentation so we have predictable memory usage.
+
+#define RD_CACHE_SIZE   2048
+uint8_t fileCache[ RD_CACHE_SIZE ];
+
+struct src_data_ctx
+{
+public:
+    const char *str = nullptr;
+#if defined(ENABLE_FS)
+    File fs;
+    int cacheLen = 0;           // Actual number of bytes read into the cache
+    int cacheBaseIndex = 0;     // The file-wide index where the current cache starts
+#endif
+    src_data_type type = src_data_string;
+    bool valid = false, cid = false, nonascii = false;
+    size_t srcSize = 0;
+    char c = 0;
+    int index = 0;
+    bool available()
+    {
+       return index < (int) srcSize;
+    }
+    size_t size()
+    {
+       if ( !srcSize )
+       {
+         if (type <= src_data_static)
+            srcSize = strlen( str );
+         else if ( fs )
+            srcSize = fs.size();
+       }
+       return srcSize;
+    }
+
+char read() {
+    if (!available()) return 0;
+
+    if (type <= src_data_static) {
+        return str[index++]; // Standard string behavior
+    }
+
+    if (type == src_data_file && fs) {
+        // If the current index is outside the window we have in RAM...
+        if (index < cacheBaseIndex || index >= (cacheBaseIndex + cacheLen)) {
+            int pos = fs.position();
+            // Align physical file to our logical index
+            if (pos != (size_t)index) {
+                fs.seek(index);
+            }
+
+            cacheBaseIndex = index; // This is the new start of our window
+            cacheLen = fs.read(fileCache, RD_CACHE_SIZE);
+
+            if (cacheLen <= 0)
+            {
+               return 0;
+            }
+        }
+
+        // Return the byte from the cache based on the offset from the start of the window
+        uint8_t val = fileCache[index - cacheBaseIndex];
+        index++; // Increment the public pointer
+        return (char)val;
+    }
+
+    return 0;
+}
+
+   // PW new method
+   size_t read(uint8_t *buf, size_t len)
+   {
+       if (!valid || !buf || len == 0) return 0;
+
+       size_t toRead = 0;
+       size_t s = size();
+
+       if (type <= src_data_static)
+       {
+           // Calculate remaining bytes in string
+           if ((size_t)index < s)
+           {
+               toRead = s - index;
+               if (toRead > len) toRead = len;
+               memcpy(buf, str + index, toRead);
+               index += toRead;
+               return toRead;
+           }
+       }
+       else if (fs)
+       {
+          size_t numRead = fs.read(buf, len);
+          if ( numRead > 0 )
+          {
+            index += numRead;
+          }
+
+          return numRead;
+       }
+       return 0;
+   }
+
+    void close()
+    {
+      if (type == src_data_file && fs)
+         fs.close();
+      cacheBaseIndex = 0;
+      cacheLen = 0;
+      index = 0;
+    }
+
+    void seek(int index)
+    {
+       this->index = index;
+    }
+};
